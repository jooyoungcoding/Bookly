{
  "name": "bookly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookly-db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS_BUCKET",
      "bucket_name": "bookly-books"
    }
  ],
  "observability": {
    "enabled": true
  }
}
